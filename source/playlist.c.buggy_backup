// playlist.c — Playlist = Favoris

#include "playlist.h"
#include "main.h"
#include "favorites.h"
#include "theme.h"
#include "i18n.h"
#include <string.h>
#include <stdio.h>
#include <stdlib.h>
#include <dirent.h>
#include <citro2d.h>

#define ROW_H  22
#define LIST_Y 30

static bool is_audio(const char *n)
{
    const char *exts[] = {
        ".mp3",".mp2",".ogg",".oga",".flac",
        ".wav",".opus",NULL
    };
    const char *d = strrchr(n,'.');
    if (!d) return false;
    for (int i = 0; exts[i]; i++)
        if (!strcasecmp(d, exts[i])) return true;
    return false;
}

static void draw_rect(float x,float y,float w,float h,u32 c)
{ C2D_DrawRectSolid(x,y,0,w,h,c); }

static void draw_text(float x,float y,float sz,u32 c,const char *t)
{
    g_textbuf_init();
    C2D_TextBufClear(g_textbuf);
    C2D_Text tx;
    C2D_TextParse(&tx,g_textbuf,t);
    C2D_TextOptimize(&tx);
    C2D_DrawText(&tx,C2D_AlignLeft|C2D_WithColor,x,y,0,sz,sz,c);
}

// ─── Init ─────────────────────────────────────────────────────
void pl_init(Playlist *pl)
{
    memset(pl, 0, sizeof(Playlist));
    pl->current  = -1;
    pl->selected = 0;
    pl->shuffle  = false;
    pl->repeat   = REPEAT_NONE;
    pl->use_favorites = false;
}

// ─── Charger les favoris dans la playlist ────────────────────
void pl_load_favorites(Playlist *pl)
{
    pl_clear(pl);
    for (int i = 0; i < g_favorites.count; i++) {
        if (pl->count >= MAX_PLAYLIST) break;
        PlaylistEntry *e = &pl->items[pl->count];
        strncpy(e->path,  g_favorites.items[i].path,  MAX_PATH-1);
        strncpy(e->title, g_favorites.items[i].title, MAX_FILENAME-1);
        e->duration_sec = 0;
        pl->count++;
    }
    pl->use_favorites = true;
    if (pl->count > 0) pl->current = 0;
    if (pl->shuffle) pl_rebuild_shuffle(pl);
}

// ─── Add single file ──────────────────────────────────────────
void pl_add(Playlist *pl, const char *path, const char *title)
{
    if (pl->count >= MAX_PLAYLIST) return;
    PlaylistEntry *e = &pl->items[pl->count];
    strncpy(e->path,  path,  MAX_PATH-1);
    strncpy(e->title, title, MAX_FILENAME-1);
    e->duration_sec = 0;
    if (pl->current < 0) pl->current = 0;
    /* V0.97 : shuffle_order lineaire par defaut (0,1,2,...) - evite indices non init */
    pl->shuffle_order[pl->count] = pl->count;
    pl->count++;
    pl->use_favorites = false;
    /* V0.97 : NE PAS rebuild shuffle a chaque ajout (fait a la fin par pl_add_dir) */
}

// ─── Add all audio files from a directory ────────────────────
/* V0.97 : Tri alphabetique de la playlist par titre */
static int pl_cmp_alpha(const void *a, const void *b) {
    const PlaylistEntry *ea = (const PlaylistEntry*)a;
    const PlaylistEntry *eb = (const PlaylistEntry*)b;
    return strcasecmp(ea->title, eb->title);
}

static void pl_sort_alpha(Playlist *pl) {
    if (pl->count < 2) return;
    /* Sauvegarder le path courant pour retrouver l index apres tri */
    char cur_path[MAX_PATH] = {0};
    if (pl->current >= 0 && pl->current < pl->count) {
        strncpy(cur_path, pl->items[pl->current].path, MAX_PATH-1);
    }

    qsort(pl->items, pl->count, sizeof(PlaylistEntry), pl_cmp_alpha);

    /* Retrouver l index apres tri */
    if (cur_path[0]) {
        for (int i = 0; i < pl->count; i++) {
            if (strcmp(pl->items[i].path, cur_path) == 0) {
                pl->current = i;
                break;
            }
        }
    }

    /* Reset shuffle_order lineaire (0,1,2,...) */
    for (int i = 0; i < pl->count; i++) pl->shuffle_order[i] = i;
    if (pl->shuffle) pl_rebuild_shuffle(pl);
}

void pl_add_dir(Playlist *pl, const char *dir_path)
{
    DIR *d = opendir(dir_path);
    if (!d) return;
    struct dirent *ent;
    while ((ent = readdir(d))) {
        if (!is_audio(ent->d_name)) continue;
        char fp[MAX_PATH];
        snprintf(fp, MAX_PATH, "%s/%s", dir_path, ent->d_name);
        pl_add(pl, fp, ent->d_name);
    }
    closedir(d);
    pl->use_favorites = false;
    /* V0.97 : TRIER par nom alphabetique (comme dans l explorateur !) */
    pl_sort_alpha(pl);
}

void pl_remove(Playlist *pl, int idx)
{
    if (idx < 0 || idx >= pl->count) return;

    /* Si mode favoris → retirer aussi des favoris */
    if (pl->use_favorites)
        fav_remove(pl->items[idx].path);

    for (int i = idx; i < pl->count-1; i++)
        pl->items[i] = pl->items[i+1];
    pl->count--;
    if (pl->current >= pl->count) pl->current = pl->count-1;
    if (pl->shuffle) pl_rebuild_shuffle(pl);
}

void pl_clear(Playlist *pl)
{
    pl->count = 0;
    pl->current = -1;
    pl->selected = 0;
    pl->scroll_offset = 0;
    pl->use_favorites = false;
}

// ─── Shuffle ──────────────────────────────────────────────────
void pl_toggle_shuffle(Playlist *pl)
{
    pl->shuffle = !pl->shuffle;
    if (pl->shuffle) pl_rebuild_shuffle(pl);
}

void pl_rebuild_shuffle(Playlist *pl)
{
    for (int i = 0; i < pl->count; i++) pl->shuffle_order[i] = i;
    for (int i = pl->count-1; i > 0; i--) {
        int j = rand() % (i+1);
        int tmp = pl->shuffle_order[i];
        pl->shuffle_order[i] = pl->shuffle_order[j];
        pl->shuffle_order[j] = tmp;
    }
}

// ─── Navigation ───────────────────────────────────────────────
int pl_next(Playlist *pl)
{
    FILE *_fn = fopen("sdmc:/3DSoundShell/pl_debug.log", "a");
    if (_fn) {
        fprintf(_fn, "pl_next: current=%d count=%d shuffle=%d repeat=%d\n",
            pl->current, pl->count, pl->shuffle, pl->repeat);
        /* V0.97 debug : afficher shuffle_order si shuffle actif */
        if (pl->shuffle && pl->count <= 20) {
            fprintf(_fn, "  shuffle_order: ");
            for (int i = 0; i < pl->count; i++)
                fprintf(_fn, "%d ", pl->shuffle_order[i]);
            fprintf(_fn, "\n");
        }
        /* Trouver pos actuel dans shuffle_order */
        if (pl->shuffle) {
            int pos = -1;
            for (int i = 0; i < pl->count; i++)
                if (pl->shuffle_order[i] == pl->current) { pos = i; break; }
            fprintf(_fn, "  current pos in shuffle_order: %d\n", pos);
        }
        fclose(_fn);
    }

    if (pl->count <= 0) return -1;
    if (pl->repeat == REPEAT_ONE) return pl->current;

    int next;
    if (pl->shuffle) {
        int pos = 0;
        for (int i = 0; i < pl->count; i++)
            if (pl->shuffle_order[i] == pl->current) { pos = i; break; }
        pos = (pos+1) % pl->count;
        if (pos == 0 && pl->repeat == REPEAT_NONE) return -1;
        next = pl->shuffle_order[pos];
    } else {
        next = pl->current + 1;
        if (next >= pl->count) {
            if (pl->repeat == REPEAT_ALL) next = 0;
            else return -1;
        }
    }
    pl->current = next;

    return next;
}

int pl_prev(Playlist *pl)
{
    FILE *_f = fopen("sdmc:/3DSoundShell/pl_debug.log", "a");
    if (_f) {
        fprintf(_f, "pl_prev: current=%d count=%d shuffle=%d repeat=%d\n",
            pl->current, pl->count, pl->shuffle, pl->repeat);
        fclose(_f);
    }

    if (pl->count <= 0) return -1;
    if (pl->repeat == REPEAT_ONE) return pl->current;
    int prev;
    if (pl->shuffle) {
        int pos = 0;
        for (int i = 0; i < pl->count; i++)
            if (pl->shuffle_order[i] == pl->current) { pos = i; break; }
        pos = (pos-1+pl->count) % pl->count;
        prev = pl->shuffle_order[pos];
    } else {
        prev = pl->current - 1;
        if (prev < 0) prev = (pl->repeat == REPEAT_ALL) ? pl->count-1 : 0;
    }
    pl->current = prev;

    FILE *_ff = fopen("sdmc:/3DSoundShell/pl_debug.log", "a");
    if (_ff) {
        fprintf(_ff, "  -> prev=%d\n", prev);
        fclose(_ff);
    }

    return prev;
}

int pl_jump(Playlist *pl, int idx)
{
    FILE *_f = fopen("sdmc:/3DSoundShell/pl_debug.log", "a");
    if (_f) {
        fprintf(_f, "pl_jump: idx=%d (was current=%d)\n", idx, pl->current);
        fclose(_f);
    }
    if (idx < 0 || idx >= pl->count) return -1;
    pl->current = idx;
    return idx;
}

// ─── Save / Load M3U ──────────────────────────────────────────
bool pl_save(const Playlist *pl, const char *path)
{
    FILE *f = fopen(path, "w");
    if (!f) return false;
    fprintf(f, "#EXTM3U\n");
    for (int i = 0; i < pl->count; i++)
        fprintf(f, "#EXTINF:%d,%s\n%s\n",
            pl->items[i].duration_sec,
            pl->items[i].title,
            pl->items[i].path);
    fclose(f);
    return true;
}

bool pl_load(Playlist *pl, const char *path)
{
    FILE *f = fopen(path, "r");
    if (!f) return false;
    pl_clear(pl);
    char line[MAX_PATH];
    char title[MAX_FILENAME] = "";
    while (fgets(line, sizeof(line), f)) {
        line[strcspn(line, "\r\n")] = 0;
        if (!strncmp(line, "#EXTINF:", 8)) {
            char *comma = strchr(line, ',');
            if (comma) snprintf(title, MAX_FILENAME, "%s", comma+1);
        } else if (line[0] != '#' && line[0] != '\0') {
            pl_add(pl, line, title[0] ? title : line);
            title[0] = 0;
        }
    }
    fclose(f);
    return true;
}

// ─── Draw ─────────────────────────────────────────────────────
void pl_draw_top(const Playlist *pl)
{
    Theme *th = current_theme;
    draw_rect(0, 0, TOP_WIDTH, 26, th->bg_header);

    if (pl->use_favorites)
        draw_text(8, 5, 0.55f, th->text_accent, "3DSoundShell  —  Favoris");
    else
        draw_text(8, 5, 0.55f, th->text_accent, "3DSoundShell  —  Playlist");

    if (pl->count == 0) {
        if (pl->use_favorites) {
            draw_text(30, 100, 0.52f, th->text_disabled, T("Aucun favori !"));
            draw_text(20, 125, 0.45f, th->text_disabled, T("Ajoute des favoris avec L"));
            draw_text(20, 145, 0.45f, th->text_disabled, T("dans le navigateur de fichiers"));
        } else {
            draw_text(50, 110, 0.55f, th->text_disabled, T("Playlist vide"));
        }
        return;
    }

    /* Infos shuffle/repeat */
    char status[80];
    const char *rep_str[] = {"─", "rep 1", "rep ∞"};
    snprintf(status, 80, "  %s  %s  %d pistes",
        pl->shuffle ? "Aleatoire" : "Ordre normal",
        rep_str[pl->repeat],
        pl->count);
    draw_text(8, 30, 0.45f, th->text_secondary, status);

    /* Piste en cours */
    if (pl->current >= 0 && pl->current < pl->count) {
        draw_rect(0, 50, TOP_WIDTH, 2, th->accent);
        draw_text(10, 58, 0.52f, th->text_accent, T("En lecture :"));
        char buf[60];
        snprintf(buf, 60, "%s", pl->items[pl->current].title);
        draw_text(10, 75, 0.5f, th->text_primary, buf);
    }
}

void pl_draw_bottom(Playlist *pl)
{
    Theme *th = current_theme;
    int vis = (BOT_HEIGHT - LIST_Y) / ROW_H;

    draw_rect(0, 0, BOT_WIDTH, BOT_HEIGHT, th->bg_primary);
    draw_rect(0, 0, BOT_WIDTH, LIST_Y,     th->bg_header);

    /* Header */
    char hdr[48];
    if (pl->use_favorites)
        snprintf(hdr, 48, "Favoris [%d/%d]",
            pl->current >= 0 ? pl->current+1 : 0, pl->count);
    else
        snprintf(hdr, 48, "Playlist [%d/%d]",
            pl->current >= 0 ? pl->current+1 : 0, pl->count);
    draw_text(6, 7, 0.5f, th->text_primary, hdr);

    if (pl->count == 0) {
        if (pl->use_favorites)
            draw_text(10, 80, 0.48f, th->text_disabled,
                T(T("Aucun favori - appuie sur L")));
        return;
    }

    int end = pl->scroll_offset + vis;
    if (end > pl->count) end = pl->count;

    for (int i = pl->scroll_offset; i < end; i++) {
        float y = LIST_Y + (i - pl->scroll_offset) * ROW_H;

        u32 bg;
        if (i == pl->current)        bg = th->bg_playing;
        else if (i == pl->selected)  bg = th->bg_selected;
        else                         bg = th->bg_primary;
        draw_rect(0, y, BOT_WIDTH, ROW_H, bg);

        if (i%2 == 0 && i != pl->selected && i != pl->current)
            draw_rect(0, y, BOT_WIDTH, ROW_H, RGBA8(0,0,0,12));

        /* Numéro */
        char num[6]; snprintf(num, 6, "%d", i+1);
        draw_text(4, y+4, 0.4f, th->text_disabled, num);

        /* Étoile si favori */
        if (!pl->use_favorites && fav_is_fav(pl->items[i].path))
            draw_text(22, y+4, 0.44f, th->accent2, "*");

        /* Titre */
        char name[36]; snprintf(name, 36, "%s", pl->items[i].title);
        u32 col = (i == pl->current) ? th->text_accent : th->text_primary;
        draw_text(32, y+4, 0.44f, col, name);

        /* Indicateur lecture */
        if (i == pl->current)
            draw_text(BOT_WIDTH-18, y+4, 0.44f, th->accent, ">");

        draw_rect(0, y+ROW_H-1, BOT_WIDTH, 1, th->border);
    }

    /* Flèches tactiles */
    draw_rect(300, 30,  20, 22, th->bg_secondary);
    draw_text(304, 33,  0.50f, th->text_primary, "^");
    draw_rect(300, 218, 20, 22, th->bg_secondary);
    draw_text(304, 221, 0.50f, th->text_primary, "v");

    /* Notif MAJ temporaire */
    draw_update_notif_timed();

    /* Scrollbar */
    if (pl->count > vis) {
        float sb_h = (float)(BOT_HEIGHT-LIST_Y) / pl->count * vis;
        float sb_y = LIST_Y + (float)pl->scroll_offset/pl->count*(BOT_HEIGHT-LIST_Y);
        draw_rect(BOT_WIDTH-4, LIST_Y, 4, BOT_HEIGHT-LIST_Y, th->bg_secondary);
        draw_rect(BOT_WIDTH-4, sb_y,   4, sb_h, th->scrollbar);
    }
}
